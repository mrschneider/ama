{
  "kernel": {
    "socket": "/tmp/ama_exp.sock",
    "ledger": "/tmp/ama_exp/ledger.jsonl",
    "hb_interval_ms": 150,
    "hb_timeout_ms": 3000,
    "max_respawns": 0
  },
  "agents": [
    {
      "name": "src",
      "task": "experiments/tasks_006/src.json",
      "qos": {
        "max_msgs_per_sec": 3
      },
      "caps": [
        "send:dtn",
        "send:burst"
      ]
    },
    {
      "name": "burst",
      "task": "experiments/tasks_006/burst.json",
      "qos": {
        "max_msgs_per_sec": 50
      },
      "caps": [
        "send:src"
      ]
    },
    {
      "name": "dtn",
      "task": "experiments/tasks_006/dtn.json",
      "dtn": true,
      "caps": [
        "send:src"
      ]
    }
  ]
}
